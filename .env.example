# PostgreSQL connection for the dashboard (server.ps1 and tracking-poller.ps1).
# Copy to .env and fill in. Real environment variables with these names
# override this file.
#
# Using docker-compose.yml? Leave DB_HOST and DB_SSLMODE blank here - it sets
# both for you. DB_USER/DB_PASS/DB_DATABASE below also become the PostgreSQL
# container's own credentials (see "Docker deployment" in README.md).
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASS=
DB_SCHEMA=gifting
# Optional: Disable | Allow | Prefer | Require | VerifyCA | VerifyFull (default Require)
# DB_SSLMODE=Require

# Behind a reverse proxy / HTTPS (see README "Production deployment")
# TRUST_PROXY=true
# COOKIE_SECURE=true

# Admin login - set directly in your host's environment variables (e.g.
# Render's "Environment" tab), never written into this file or committed.
# ADMIN_PASSWORD set: that account's password is (re)set to it on every
# start - created first if it doesn't exist. Also doubles as a reset tool:
# point ADMIN_USERNAME at any existing locked-out account and restart.
# Leave both unset to keep the original behavior (random password, printed
# once to the console on the very first start).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
